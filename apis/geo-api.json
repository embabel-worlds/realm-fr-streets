{"openapi":"3.0.3","info":{"title":"geo.api.gouv.fr","version":"1.0.0","description":"Keyless French administrative geography (communes, departements, population, surface in hectares)."},"servers":[{"url":"https://geo.api.gouv.fr"}],"paths":{"/communes":{"get":{"operationId":"frCommunes","summary":"Communes, optionally filtered","description":"Array of communes: code (INSEE), nom, population, surface (hectares), codeDepartement, codesPostaux[], centre.coordinates [lon,lat]. With no filter returns all ~35,000. For a search box: nom=<text>&boost=population&limit=10 returns the most populous matches first.","parameters":[{"name":"code","in":"query","required":false,"schema":{"type":"string"},"description":"INSEE code."},{"name":"codePostal","in":"query","required":false,"schema":{"type":"string"},"description":"Postal code (many-to-many with communes)."},{"name":"nom","in":"query","required":false,"schema":{"type":"string"},"description":"Name search (fuzzy)."},{"name":"boost","in":"query","required":false,"schema":{"type":"string"},"description":"'population' ranks bigger communes first."},{"name":"limit","in":"query","required":false,"schema":{"type":"string"},"description":"Max results."},{"name":"lat","in":"query","required":false,"schema":{"type":"string"},"description":"Latitude."},{"name":"lon","in":"query","required":false,"schema":{"type":"string"},"description":"Longitude."},{"name":"fields","in":"query","required":false,"schema":{"type":"string"},"description":"Comma list, e.g. code,nom,population,surface,codeDepartement,codesPostaux,centre."}],"responses":{"200":{"description":"JSON","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/departements":{"get":{"operationId":"frDepartements","summary":"All departements","description":"Array of {code, nom, codeRegion} for every departement (101).","parameters":[],"responses":{"200":{"description":"JSON","content":{"application/json":{"schema":{"type":"object"}}}}}}}}}
